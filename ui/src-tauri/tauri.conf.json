{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WinXtend",
  "version": "0.1.0",
  "identifier": "dev.winxtend.ui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "WinXtend",
        "width": 1120,
        "height": 780,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Share one keyboard and mouse across machines",
    "longDescription": "WinXtend shares one keyboard and mouse across Mac, Windows, Linux and ARM machines by moving the cursor off the edge of a screen.",
    "externalBin": ["binaries/wx-agent"],
    "linux": {
      "deb": {
        "depends": ["xdg-desktop-portal", "xdg-desktop-portal-gnome", "libei1"],
        "files": {
          "/usr/lib/systemd/user/winxtend.service": "../../packaging/winxtend.service"
        }
      }
    }
  }
}
