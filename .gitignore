# ---------------------------------------------------------------- Rust
/target
**/target
*.pdb
# Coverage instrumentation output
*.profraw
*.profdata

# Cargo.lock IS committed: this workspace ships binaries, so a reproducible
# dependency set matters more than library-style version flexibility.
Cargo.lock.bak

# ---------------------------------------------------------------- Node / Tauri
node_modules/
/ui/dist
/ui/.vite
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# tauri-build regenerates these from tauri.conf.json on every build, so a
# committed copy is only ever a stale copy.
/ui/src-tauri/gen/schemas

# Bundled installers and app images
/ui/src-tauri/target/release/bundle

# Build products of ui/scripts/bundle-agent.mjs. Both are copies of something
# already in the tree — the release `wx-agent`, and `packaging/winxtend.service.in`
# with its placeholder filled in — so committing either would only ever mean
# shipping a stale one.
/ui/src-tauri/binaries
/packaging/winxtend.service

# ---------------------------------------------------------------- Secrets and local state
# The agent keeps its ed25519 identity key, trust store, and cached layout in the
# per-user OS config directory, NOT in the repo. These patterns exist to catch a
# run started with `--config-dir .` inside a checkout, which would otherwise put
# a private key one `git add -A` away from being published.
/.wx-state
identity.key
trust.toml
*.local.toml
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example

# Signing keys for release updates
*.tauri-private.key

# ---------------------------------------------------------------- Editors and tooling
# Pattern must be `.vscode/*`, not `.vscode/`: git cannot re-include a file from
# inside a directory that is itself excluded, so the negation below would be dead.
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.claude/settings.local.json

# ---------------------------------------------------------------- OS noise
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
